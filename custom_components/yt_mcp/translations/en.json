{
  "config": {
    "step": {
      "user": {
        "title": "Connect to a yt-mcp server",
        "description": "Needs yt-mcp 2.10.0 or newer (analytics need 2.11.0). Create the read-only token on the server with `docker compose run --rm yt-mcp python -m ytmcp gen-status-token`, put the hash line in `.env` and restart the container.",
        "data": {
          "url": "Server URL",
          "token": "Status token",
          "verify_ssl": "Verify the TLS certificate"
        },
        "data_description": {
          "url": "Base URL of the server, without /admin or /mcp.",
          "token": "The read-only token printed by gen-status-token. It opens status.json and stats.json and nothing else."
        }
      },
      "reauth_confirm": {
        "title": "New status token",
        "description": "The server at {url} refused the status token. Generate a new one with gen-status-token and enter it here.",
        "data": {
          "token": "Status token"
        }
      },
      "reconfigure": {
        "title": "Change the yt-mcp server",
        "data": {
          "url": "Server URL",
          "token": "Status token",
          "verify_ssl": "Verify the TLS certificate"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the server, or it did not answer like yt-mcp.",
      "invalid_auth": "The server refused the token.",
      "not_supported": "No /admin/status.json at this URL: check the URL, or upgrade the server to 2.10.0 or newer.",
      "unknown": "Unexpected error, see the log."
    },
    "abort": {
      "already_configured": "This server is already configured.",
      "reauth_successful": "Token updated.",
      "reconfigure_successful": "Server updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "data": {
          "status_interval": "Health check interval",
          "stats_interval": "Analytics interval"
        },
        "data_description": {
          "status_interval": "How often to read status.json (problems, poller, quota).",
          "stats_interval": "How often to read stats.json. The server reads YouTube every 15 minutes at best, so faster adds nothing."
        }
      }
    }
  },
  "issues": {
    "stats_unsupported": {
      "title": "yt-mcp server has no analytics endpoint",
      "description": "The server at {url} runs yt-mcp {version}, which has no /admin/stats.json. Health entities work; the analytics entities appear after you upgrade the server to 2.11.0 or newer and reload the integration."
    }
  },
  "entity": {
    "binary_sensor": {
      "problem": { "name": "Problem" },
      "google_token": { "name": "Google authorisation" },
      "quota_exhausted": { "name": "Quota exhausted" },
      "positioning_review_due": { "name": "Positioning review due" }
    },
    "sensor": {
      "last_poll": { "name": "Last poll" },
      "poll_interval": { "name": "Poll interval" },
      "backup_age": { "name": "Backup age" },
      "quota_used": { "name": "Quota used" },
      "quota_used_pct": { "name": "Quota used percentage" },
      "metadata_pending": { "name": "Videos without metadata" },
      "watched_today": { "name": "Watched today" },
      "added_today": { "name": "Added today" },
      "watched_hours_today": { "name": "Watch time today" },
      "watched_7d": { "name": "Watched this week" },
      "added_7d": { "name": "Added this week" },
      "watched_hours_7d": { "name": "Watch time this week" },
      "watched_change_7d": { "name": "Watched vs previous week" },
      "watched_30d": { "name": "Watched in 30 days" },
      "watched_per_day": { "name": "Watched per day" },
      "median_wait": { "name": "Median wait before watching" },
      "backlog_items": { "name": "Backlog" },
      "backlog_hours": { "name": "Backlog hours" },
      "days_to_empty": { "name": "Days to empty" },
      "last_watched": { "name": "Last watched" },
      "last_watched_at": { "name": "Last watched at" },
      "stalest_wait": { "name": "Longest wait" },
      "most_watched_theme": { "name": "Most watched theme" },
      "stalled_themes": { "name": "Stalled themes" },
      "attention": { "name": "Attention items" },
      "quota_remaining": { "name": "Quota remaining" },
      "quota_reset": { "name": "Quota reset" },
      "playlist_items": { "name": "{playlist} backlog" },
      "playlist_hours": { "name": "{playlist} backlog hours" },
      "playlist_watched_today": { "name": "{playlist} watched today" },
      "playlist_watched_7d": { "name": "{playlist} watched this week" },
      "playlist_days_to_empty": { "name": "{playlist} days to empty" },
      "theme_items": { "name": "{theme} backlog" }
    }
  }
}
